{
  "extends": "./tsconfig.web.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@renderer/*": ["./src/renderer/*"],
      "@main/*": ["./src/main/*"]
    }
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/shared/**/*.ts", "src/env.d.ts", "test/**/*.tsx"]
}
