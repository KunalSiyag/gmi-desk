exports[`seatbelt profile (macOS, snapshot only) > denies by default, writes only to the worktree and this thread’s git dirs, network only to the proxy socket 1`] = `
"(version 1)
(deny default)
(allow process-exec)
(allow process-fork)
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow mach-lookup (global-name "com.apple.system.opendirectoryd.libinfo"))
(allow file-read*)
(deny file-read* (require-all (subpath "/Users") (require-not (subpath "/Users/u"))))
(deny file-read* (subpath "/Users/u/.ssh"))
(deny file-read* (subpath "/Users/u/.gnupg"))
(deny file-read* (subpath "/Users/u/.aws"))
(deny file-read* (subpath "/Users/u/.config/gh"))
(deny file-read* (subpath "/Users/u/.factory"))
(deny file-read* (subpath "/Users/u/.claude.json"))
(deny file-read* (subpath "/Users/u/.docker"))
(deny file-read* (subpath "/Users/u/.kube"))
(deny file-read* (subpath "/Users/u/.netrc"))
(deny file-read* (subpath "/Users/u/.npmrc"))
(deny file-read* (subpath "/Users/u/.pypirc"))
(deny file-read* (subpath "/Users/u/.git-credentials"))
(deny file-read* (subpath "/Users/u/Library/Keychains"))
(allow file-write-data (literal "/dev/null") (literal "/dev/zero") (literal "/dev/tty"))
(allow file-write* (subpath "/home/u/.local/share/gmi-desk/wt/th1"))
(allow file-write* (subpath "/home/u/src/proj/.git/worktrees/th1"))
(allow file-write* (subpath "/home/u/src/proj/.git/refs/heads/gmi/abc123"))
(allow file-write* (subpath "/home/u/src/proj/.git/logs/refs/heads/gmi/abc123"))
(allow file-write* (subpath "/data/harness/objects/th1"))
(allow file-write* (subpath "/data/harness/cache/th1"))
(allow file-write* (subpath "/private/tmp/x"))
(deny file-write* (subpath "/home/u/.local/share/gmi-desk/wt/th1/.git"))
(deny file-write* (subpath "/home/u/src/proj/.git"))
(deny file-write* (subpath "/home/u/src/proj/.git/worktrees/th1/gitdir"))
(deny file-write* (subpath "/home/u/src/proj/.git/worktrees/th1/commondir"))
(deny file-write* (subpath "/home/u/src/proj/.git/worktrees/th1/config.worktree"))
(deny file-write* (subpath "/home/u/.local/share/gmi-desk/wt/th1/.husky"))
(deny file-write* (subpath "/home/u/.local/share/gmi-desk/wt/th1/AGENTS.md"))
(deny file-read* file-write* (literal "/home/u/.local/share/gmi-desk/wt/th1/.env"))
(allow network-outbound (remote unix-socket (path-literal "/data/proxy/proxy.sock")))
(allow network-bind network-inbound (local ip "localhost:3128"))
(allow network-outbound (remote ip "localhost:3128"))
"
`;
